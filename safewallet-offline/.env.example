# Copia a .env (opcional: docker compose ya trae valores por defecto de desarrollo)
POSTGRES_USER=safewallet
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=safewallet
BACKEND_PORT=3000
SANDBOX_API_KEY=sw_sandbox_demo_key
ADMIN_API_KEY=sw_admin_demo_key
# Producción: secretos reales (nunca en git). MASTER_SECRET = 32 bytes hex.
# MASTER_SECRET=
# SERVER_SIGNING_KEY_PEM_B64=
# SERVER_SIGNING_PUBLIC_KEY=
LOG_LEVEL=info
