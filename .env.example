# ============================================================================
# KOPERA Fintech + QARY AI — example env. Copy to .env and fill. NEVER commit secrets.
# ============================================================================

# ---------- App ----------
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=postgresql://qary:qary@localhost:5432/qary
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=change-me-in-prod-use-vault
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_HOUR=5
BCRYPT_ROUNDS=10
HMAC_SECRET=change-me-receipt-hmac-key

# ---------- Stripe (sandbox) ----------
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Maps ----------
MAPBOX_TOKEN=pk.xxx
GOOGLE_MAPS_API_KEY=

# ---------- Messaging ----------
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_SMS=+15550000000
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886

# ---------- Email (Transactional — Agent 38) ----------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=no-reply@kopera.io
EMAIL_COMPLIANCE_CC=compliance@kopera.io

# ---------- Storage (S3-compatible / MinIO local) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kopera-media
S3_PUBLIC_BASE_URL=http://localhost:9000/kopera-media
SIGNED_URL_TTL_SECONDS=3600

# ---------- WebRTC ----------
TURN_URL=turn:localhost:3478
TURN_USERNAME=qary
TURN_PASSWORD=qary
STUN_URL=stun:stun.l.google.com:19302
SFU_ENABLED=false

# ---------- Agents (LLM) — Qary Core ----------
ANTHROPIC_API_KEY=sk-ant-xxx
AGENT_MODEL=claude-haiku-4-5
AGENT_RATE_LIMIT_PER_MIN=30
AGENT_VOICE_PIN_REQUIRED=true

# ---------- Kopera Gateway ----------
KOPERA_GATEWAY_MERCHANT_ID=kopera_default
KOPERA_GATEWAY_WEBHOOK_SECRET=whsec_kopera_xxx

# ---------- KYC / KYB Providers ----------
PERSONA_API_KEY=persona_xxx
SUNAT_API_URL=https://api.sunat.gob.pe
SUNAT_API_TOKEN=xxx

# ---------- FX Data Providers ----------
FX_PROVIDER=oanda
OANDA_API_KEY=xxx
EXCHANGERATE_HOST_KEY=xxx

# ---------- Security / retention ----------
EVIDENCE_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
RATE_LIMIT_GLOBAL_PER_MIN=120
PCI_VAULT_ENDPOINT=http://localhost:8200

# ---------- Observability ----------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
